# Copy this file to .env and fill in real values. .env is gitignored and
# never committed — for the live site, set these same variables in
# Vercel → Project Settings → Environment Variables.

# Powers the AI chatbot (src/components/AIChat.jsx via api/chat.js).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Powers the contact form (src/components/Contact.jsx via api/contact.js).
# Get a free key at https://resend.com/api-keys
RESEND_API_KEY=
